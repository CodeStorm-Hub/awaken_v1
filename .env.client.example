# Copy to .env.client and fill in real values. .env.client is gitignored
# but IS bundled into the app binary as a Flutter asset — only put values
# here that are safe to ship client-side.

SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx

GOOGLE_ANDROID_CLIENT_ID=xxx.apps.googleusercontent.com
GOOGLE_OAUTH_CLIENT_ID=xxx.apps.googleusercontent.com

# Territory map style — a MapLibre style.json URL, rendered via maplibre_gl
# (real vector tiles, not raster). Leave unset to use the built-in default
# (OpenFreeMap's free "Liberty" style, no API key, commercial use OK — see
# openfreemap.org). Override with your own self-hosted (e.g. tileserver-gl)
# or commercial style URL if/when you need one.
MAP_STYLE_URL=

# Optional manual fallback if the primary style host has an outage — plugin
# doesn't expose a per-tile error hook, so this is a manual override, not
# an automatic runtime switch.
MAP_STYLE_FALLBACK_URL=

# Sentry DSN (public identifier, not a secret — safe to ship client-side).
# Leave unset to run with Sentry effectively disabled (no crash reporting).
SENTRY_DSN=
