# Copy to .env.client and fill in real values. .env.client is gitignored
# but IS bundled into the app binary as a Flutter asset — only put values
# here that are safe to ship client-side.

SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx

GOOGLE_ANDROID_CLIENT_ID=xxx.apps.googleusercontent.com
GOOGLE_OAUTH_CLIENT_ID=xxx.apps.googleusercontent.com

# Territory map tile provider (plan C3 — never point this at the OSM public
# tile server in production). Optional: leave unset and TerritoryPage shows
# a "map tiles not configured" state instead of a blank/broken map. Must be a
# raster XYZ template ({z}/{x}/{y}) — flutter_map's TileLayer renders raster
# only. Sign up for a free tier (MapTiler, Stadia Maps, or Thunderforest) and
# paste their URL template, API key included per their convention, e.g.:
# MAP_TILE_URL_TEMPLATE=https://api.maptiler.com/maps/streets-v2/{z}/{x}/{y}.png?key=xxx
#
# Note: OpenFreeMap is NOT usable here directly — it only serves vector
# tiles (a MapLibre style.json), not raster XYZ. Using it would need the
# vector_map_tiles package instead of a plain TileLayer (a separate,
# larger integration, not wired up in this app yet).
MAP_TILE_URL_TEMPLATE=
MAP_TILE_ATTRIBUTION=MapTiler © OpenStreetMap contributors

# Optional second raster provider — the map automatically switches to this
# one if the primary's tiles start failing to load (outage/rate-limit),
# since free-tier tile hosts don't commit to an uptime SLA. Leave unset to
# skip the fallback (the map just keeps retrying the primary).
MAP_TILE_FALLBACK_URL_TEMPLATE=
MAP_TILE_FALLBACK_ATTRIBUTION=
