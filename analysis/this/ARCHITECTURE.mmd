    App[App shell & bootstrap<br/>main_common.dart / app.dart]
  end

  subgraph CoreInfra[Core Infra]
    DI[core/di]
    Env[core/config/env.dart]
    Theme[core/theme]
  end

  subgraph PlatformBridge[Platform Bridge - Android only]
    SysCap[core/platform/system_capabilities.dart]
    MainActivity[android MainActivity.kt]
  end

  subgraph SyncEngine[Sync Engine]
    LocalWriter[sync/outbox/local_writer.dart]
