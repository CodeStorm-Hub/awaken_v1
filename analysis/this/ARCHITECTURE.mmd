  App --> Alarm
  App --> Onboarding
  App --> Profile
  App --> SyncWorker
  App --> Pull
  App --> DI

  Alarm --> LocalWriter
  Alarm --> SysCap
  Alarm --> Verification
  LocalWriter --> Drift
  SyncWorker --> Drift
  SyncWorker -->|SupabaseClient| Supabase[(Supabase: alarms/sessions/runs/user_stats)]

  Territory -->|SupabaseClient RPC submit_run| Supabase
  Territory --> Verification
  Squad -->|SupabaseClient RPCs| Supabase
  Profile -->|SupabaseClient auth| Supabase

  Onboarding --> SysCap
  SysCap -->|MethodChannel| MainActivity
  MainActivity -.no iOS equivalent.-> AppDelegate[ios AppDelegate.swift]

  Territory --> RunForegroundService[territory/data/datasources/run_foreground_service.dart]
  RunForegroundService -->|Android: real foreground service| AndroidManifest[android/app/.../AndroidManifest.xml service decl]
  RunForegroundService -.iOS: notification-only shim, unconditionally called.-> IOSNotif[flutter_foreground_task iOS path]

  Home --> Drift

  App --> Theme
  DI --> Env
