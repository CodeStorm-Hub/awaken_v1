# Bundled into the app binary as a Flutter asset (see pubspec.yaml) — only
# put values here that are safe to ship client-side. Supabase's anon /
# publishable key is designed to be public (protected by RLS, not secrecy).
# NEVER put SUPABASE_ACCESS_TOKEN or any other management/API secret here —
# that belongs in .env (tooling-only, never bundled).

SUPABASE_URL=https://qxxkydisyqnodskmymla.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_NMLOSxFpygq5DLvD65QcgQ_Mz2XWWME

GOOGLE_ANDROID_CLIENT_ID=230513820686-vp9s90osdr3rl4n7gg5nrv270vkjle5f.apps.googleusercontent.com
GOOGLE_OAUTH_CLIENT_ID=230513820686-ku2co5m68332qjv7t0cgbe5vk8nlvrea.apps.googleusercontent.com

# Territory map style (MapLibre vector tiles, rendered via maplibre_gl).
# Leave unset to use the default (OpenFreeMap's free "Liberty" style, no
# API key needed). Override with your own self-hosted/commercial style.json
# URL if you need one later.
MAP_STYLE_URL=

# Optional second hosted style, tried automatically if the primary times
# out (see MapStyleLoader).
MAP_STYLE_FALLBACK_URL=

# Base URL of the self-hosted tile Worker in infra/tile-worker/ — deployed,
# last-resort fallback tier (see MapStyleLoader).
TILE_WORKER_BASE_URL=https://awaken-tile-fallback.codestormhub.workers.dev

# Sentry DSN (public identifier, not a secret). Left unset — no Sentry
# project provisioned yet. SentryFlutter.init runs with dsn: '' in the
# meantime, which is a safe no-op (still installs error handlers, sends
# nothing). Fill in once a project exists at sentry.io.
SENTRY_DSN=
