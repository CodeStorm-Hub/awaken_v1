# Miscellaneous
*.class
*.log
*.pyc
*.swp
.DS_Store
.atom/
.build/
.buildlog/
.history
.svn/
.swiftpm/
migrate_working_dir/

# IntelliJ related
*.iml
*.ipr
*.iws
.idea/

# The .vscode folder contains launch configuration and tasks you configure in
# VS Code which you may wish to be included in version control, so this line
# is commented out by default.
#.vscode/

# Flutter/Dart/Pub related
**/doc/api/
**/ios/Flutter/.last_build_id
.dart_tool/
.flutter-plugins-dependencies
.pub-cache/
.pub/
/build/
/coverage/

# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release

# Machine-specific SDK paths
**/android/local.properties

# Secrets (Supabase URL/anon key, Sentry DSN, etc.) — never commit real values
.env
.env.*
!.env.example
!.env.client.example
!.env.client

# Claude Code local settings
.claude/settings.local.json
/infra/tile-worker/node_modules

# Generated PMTiles basemap extract — large binary, regenerate via
# infra/tile-worker/generate_basemap.sh instead of committing it.
/infra/tile-worker/generated/*.pmtiles
/infra/tile-worker/dist
