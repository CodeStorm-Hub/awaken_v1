{
  "plugins": [
    "react",
    "import"
  ],
  "rules": {
    "react/forbid-elements": [
      "warn",
      {
        "forbid": []
      }
    ],
    "no-restricted-imports": [
      "warn",
      {
        "patterns": [
          {
            "group": [
              "components/data-display/**",
              "components/feedback/**",
              "components/forms/**",
              "components/overlays/**",
              "ui_kits/awaken-app/**"
            ],
            "message": "Import design-system components from 'index.js', not component internals."
          }
        ]
      }
    ],
    "no-restricted-syntax": [
      "warn",
      {
        "selector": "Literal[value=/#[0-9a-fA-F]{3,8}\\b/]",
        "message": "Raw hex color — use a design-system color token via var()."
      },
      {
        "selector": "Literal[value=/\\b\\d+px\\b/]",
        "message": "Raw px value — use a design-system spacing token via var()."
      },
      {
        "selector": "Literal[value=/font-family\\s*:\\s*(?!['\\\"]?(?:Roboto Flex|Roboto Mono))/i]",
        "message": "Font not provided by the design system. Available: Roboto Flex, Roboto Mono."
      },
      {
        "selector": "JSXOpeningElement[name.name='Badge'] > JSXAttribute > JSXIdentifier[name!=/^(?:children|icon|tone|key|ref|className|style|children)$/]",
        "message": "<Badge> doesn't accept that prop. Declared props: children, icon, tone."
      },
      {
        "selector": "JSXOpeningElement[name.name='Badge'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:primary|success|warning|error)$/]",
        "message": "<Badge> tone must be one of 'primary' | 'success' | 'warning' | 'error'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute > JSXIdentifier[name!=/^(?:children|variant|disabled|onClick|style|key|ref|className|style|children)$/]",
        "message": "<Button> doesn't accept that prop. Declared props: children, variant, disabled, onClick, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='variant'] > Literal[value!=/^(?:filled|tonal|outlined|text)$/]",
        "message": "<Button> variant must be one of 'filled' | 'tonal' | 'outlined' | 'text'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Card'] > JSXAttribute > JSXIdentifier[name!=/^(?:children|sharp|elevation|style|key|ref|className|style|children)$/]",
        "message": "<Card> doesn't accept that prop. Declared props: children, sharp, elevation, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Chip'] > JSXAttribute > JSXIdentifier[name!=/^(?:children|selected|onClick|key|ref|className|style|children)$/]",
        "message": "<Chip> doesn't accept that prop. Declared props: children, selected, onClick."
      },
      {
        "selector": "JSXOpeningElement[name.name='Dialog'] > JSXAttribute > JSXIdentifier[name!=/^(?:title|children|actions|open|key|ref|className|style|children)$/]",
        "message": "<Dialog> doesn't accept that prop. Declared props: title, children, actions, open."
      },
      {
        "selector": "JSXOpeningElement[name.name='IconButton'] > JSXAttribute > JSXIdentifier[name!=/^(?:icon|label|tone|onClick|size|key|ref|className|style|children)$/]",
        "message": "<IconButton> doesn't accept that prop. Declared props: icon, label, tone, onClick, size."
      },
      {
        "selector": "JSXOpeningElement[name.name='IconButton'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:default|error|onDark)$/]",
        "message": "<IconButton> tone must be one of 'default' | 'error' | 'onDark'."
      },
      {
        "selector": "JSXOpeningElement[name.name='ListItem'] > JSXAttribute > JSXIdentifier[name!=/^(?:title|subtitle|trailing|onClick|key|ref|className|style|children)$/]",
        "message": "<ListItem> doesn't accept that prop. Declared props: title, subtitle, trailing, onClick."
      },
      {
        "selector": "JSXOpeningElement[name.name='ProgressSpinner'] > JSXAttribute > JSXIdentifier[name!=/^(?:size|tone|key|ref|className|style|children)$/]",
        "message": "<ProgressSpinner> doesn't accept that prop. Declared props: size, tone."
      },
      {
        "selector": "JSXOpeningElement[name.name='ProgressSpinner'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:primary|onDark)$/]",
        "message": "<ProgressSpinner> tone must be one of 'primary' | 'onDark'."
      },
      {
        "selector": "JSXOpeningElement[name.name='RepCounter'] > JSXAttribute > JSXIdentifier[name!=/^(?:current|target|label|tone|key|ref|className|style|children)$/]",
        "message": "<RepCounter> doesn't accept that prop. Declared props: current, target, label, tone."
      },
      {
        "selector": "JSXOpeningElement[name.name='RepCounter'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:light|onDark)$/]",
        "message": "<RepCounter> tone must be one of 'light' | 'onDark'."
      },
      {
        "selector": "JSXOpeningElement[name.name='StatusBanner'] > JSXAttribute > JSXIdentifier[name!=/^(?:children|tone|key|ref|className|style|children)$/]",
        "message": "<StatusBanner> doesn't accept that prop. Declared props: children, tone."
      },
      {
        "selector": "JSXOpeningElement[name.name='StatusBanner'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:onDark|surface)$/]",
        "message": "<StatusBanner> tone must be one of 'onDark' | 'surface'."
      }
    ]
  },
  "overrides": [
    {
      "files": [
        "**/index.js"
      ],
      "rules": {
        "no-restricted-imports": "off"
      }
    }
  ],
