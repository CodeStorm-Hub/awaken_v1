# Copy to .env and fill in real values. .env is gitignored — never commit it.

# Supabase (Awaken app backend)
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your-anon-or-publishable-key
SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx
SUPABASE_PROJECT_REF=your-project-ref

# Supabase management API token (used by tooling/MCP, not the app itself)
SUPABASE_ACCESS_TOKEN=sbp_xxx

# Google OAuth (from android/app/google-services.json — Android-only, no web app)
GOOGLE_ANDROID_CLIENT_ID=xxx.apps.googleusercontent.com
GOOGLE_OAUTH_CLIENT_ID=xxx.apps.googleusercontent.com
